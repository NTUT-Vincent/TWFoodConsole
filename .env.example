# This public repository is read-only without these server-side secrets.
# Set these in Vercel Project Settings > Environment Variables.
# Fine-grained GitHub token with Contents + Pull requests write permission on TWFoodMCP.
GITHUB_TOKEN=
# Long random secret known only to the authorized human reviewer.
CONSOLE_ADMIN_KEY=
# GitHub reviewer login; will be encoded as verified.by = human:<login>.
CONSOLE_REVIEWER=ntut-vincent
# Optional. Public repository remains the single source of truth.
OKF_REPO=NTUT-Vincent/TWFoodMCP
